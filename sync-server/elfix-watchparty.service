# systemd-Vorlage fuer das Watchparty-Relay.
#
#   sudo cp elfix-watchparty.service /etc/systemd/system/
#   sudo nano /etc/systemd/system/elfix-watchparty.service   # User und Pfad anpassen
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now elfix-watchparty
#
# Der Dienst schreibt nichts auf die Platte, deshalb laeuft er mit stark
# eingeschraenkten Rechten.
#
# Er ist ausserdem das Metadaten-Tor: die App fragt ihn statt TMDB, damit der
# TMDB-Schluessel nicht auf die Geraete muss. Siehe EnvironmentFile weiter unten.

[Unit]
Description=ELFIX Watchparty-Relay
Documentation=https://github.com/RoveHD/elfix
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# HIER ANPASSEN: eigener Benutzer und Ablageort des Ordners sync-server
User=DEIN_BENUTZER
WorkingDirectory=/opt/elfix-watchparty
ExecStart=/usr/bin/node server.js
Environment=NODE_ENV=production
Environment=PORT=8787

# Der TMDB-Schluessel fuer das Metadaten-Tor.
#
# Er steht bewusst NICHT in dieser Datei: sie liegt im Repository und waere
# damit oeffentlich. Stattdessen in einer eigenen Datei, die nur root lesen
# darf. Ohne sie startet der Dienst genauso - dann fehlen nur die Film- und
# Seriendaten, Watchparty und Anime laufen normal weiter.
#
#   sudo install -m 600 -o root -g root /dev/null /etc/elfix-watchparty.env
#   sudo nano /etc/elfix-watchparty.env
#       TMDB_API_TOKEN=hier-der-schluessel-von-themoviedb.org
#   sudo systemctl restart elfix-watchparty
#
# Das Minuszeichen heisst: fehlt die Datei, ist das kein Fehler.
EnvironmentFile=-/etc/elfix-watchparty.env
Restart=always
RestartSec=5

# Ablage der Raeume unter /var/lib/elfix-watchparty. Ohne sie muessten nach
# jedem Neustart alle wieder beitreten.
StateDirectory=elfix-watchparty

# Der Dienst braucht weder Schreibrechte noch zusaetzliche Privilegien.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectControlGroups=true
# AF_UNIX bleibt erlaubt, sonst laesst sich schwer nachvollziehen, was der
# Dienst ins Journal schreiben wollte.
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=256M

[Install]
WantedBy=multi-user.target
