<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!--
        ELFIX kommt nicht aus einem Laden, also holt es seine Updates selbst.
        Ohne dieses Recht darf es dem Paketinstaller keine APK reichen.

        Installiert wird trotzdem nichts von allein: der Paketinstaller fragt
        jedes Mal, und dieses Recht muss ausserdem einmal von Hand erlaubt
        werden ("Unbekannte Apps installieren"). Beides ist gut so.
    -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:allowBackup="true"
        android:banner="@drawable/tv_banner"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="ELFIX"
        android:supportsRtl="true"
        android:theme="@style/AppTheme"
        android:usesCleartextTraffic="true">
        <activity
            android:name=".MainActivity"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize|smallestScreenSize"
            android:exported="true"
            android:launchMode="singleTask"
            android:screenOrientation="unspecified">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!--
                Eigene Adressen: elfix://open?url=...

                Damit laesst sich ein Titel gezielt in ELFIX oeffnen - aus einer
                Benachrichtigung, aus einer Verknuepfung, von einem anderen
                Geraet. Ein eigenes Schema statt eines allgemeinen, weil nur
                ELFIX es benutzt und deshalb niemand gefragt werden muss, welche
                App gemeint war.
            -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="elfix" />
            </intent-filter>

            <!--
                Adressen der eingebauten Anbieter.

                Absichtlich nur diese und nicht http/https allgemein: ELFIX ist
                kein Browser, und es soll nicht bei jedem angetippten Link zur
                Auswahl stehen. Wer einen eigenen Anbieter eintraegt, oeffnet
                ihn in der App - dafuer braucht es keinen Eintrag hier.
            -->
            <intent-filter android:autoVerify="false">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" android:host="aniworld.to" />
                <data android:scheme="https" android:host="www.aniworld.to" />
                <data android:scheme="https" android:host="s.to" />
                <data android:scheme="https" android:host="www.s.to" />
                <data android:scheme="https" android:host="filmo.to" />
                <data android:scheme="https" android:host="www.filmo.to" />
            </intent-filter>
        </activity>

        <!--
            Der Weg, auf dem die heruntergeladene APK zum Paketinstaller kommt.

            Seit Android 7 darf keine App der anderen einen file://-Verweis
            reichen; wer es versucht, bekommt eine FileUriExposedException.
            Der Provider gibt stattdessen einen content://-Verweis heraus, und
            zwar nur auf den einen Ordner in res/xml/dateiwege.xml.
        -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.dateien"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/dateiwege" />
        </provider>
    </application>
</manifest>
